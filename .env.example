HF_SERVICE_URL=http://hf:8200
OLLAMA_BASE_URL=http://ollama:11434
FAISS_SERVICE_URL=http://retrieval:8000
TRAINER_SERVICE_URL=http://trainer:8100
SYSTEM_PROMPTS_SERVICE_URL=http://system-prompts:8300

POSTGRES_DB=linguacomai
POSTGRES_USER=linguacomai
POSTGRES_PASSWORD=linguacomai
POSTGRES_DSN=postgresql://linguacomai:linguacomai@postgres:5432/linguacomai

CORPUS_DIR=/corpus
TRAINING_OUTPUT_DIR=/training_output
CORPUS_VOLUME_NAME=linguacomai_corpus_data
TRAINING_OUTPUT_VOLUME_NAME=linguacomai_training_output
HF_CACHE_VOLUME_NAME=linguacomai_hf_cache

TRAINER_USE_GPU=true

# Trainer Docker control:
# Linux socket mode: leave DOCKER_HOST empty and mount /var/run/docker.sock into the trainer container.
# Windows Docker Desktop fallback: enable the Docker TCP endpoint and set DOCKER_HOST=tcp://host.docker.internal:2375
DOCKER_HOST=tcp://host.docker.internal:2375

TRAINING_CHUNK_CHAR_LENGTH=1200
TRAINING_CHUNK_CHAR_OVERLAP=200

# LLaMA-Factory training base should be a Hugging Face or local Transformers model path.
TRAINING_BASE_MODEL_PATH=TinyLlama/TinyLlama-1.1B-Chat-v1.0
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_SYSTEM_PROMPT_MODEL=llama3:8b

LLAMA_FACTORY_IMAGE=hiyouga/llamafactory:latest
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SYSTEM_PROMPT_COMPILATION_CHAR_LIMIT=24000
SYSTEM_PROMPT_BATCH_CHAR_LIMIT=9000
SYSTEM_PROMPT_DISTILL_MAX_TOKENS=220
SYSTEM_PROMPT_FINAL_MAX_TOKENS=320
OFT_COMMAND_TEMPLATE=export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True && mkdir -p /tmp/lf_data && cp {dataset_path} /tmp/lf_data/corpus.jsonl && printf '{"corpus":{"file_name":"corpus.jsonl","columns":{"prompt":"text"}}}\n' > /tmp/lf_data/dataset_info.json && llamafactory-cli train --stage pt --do_train true --model_name_or_path {base_model} --dataset_dir /tmp/lf_data --dataset corpus --finetuning_type oft --output_dir {output_dir} --overwrite_output_dir true --cutoff_len 512 --per_device_train_batch_size 1 --gradient_accumulation_steps 4 --learning_rate 5e-5 --num_train_epochs 1.0 --lr_scheduler_type cosine --warmup_ratio 0.05 --logging_steps 5 --save_steps 50 --fp16 true --preprocessing_num_workers 1

# Optional: only needed for gated or private Hugging Face models.
# HF_TOKEN=
